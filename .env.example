# AGI Kit environment configuration
# Copy to .env and fill in

# LLM endpoints
OLLAMA_HOST=http://127.0.0.1:11434
HF_TOKEN=

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=true

# Storage
DATA_DIR=./data
MODEL_CACHE_DIR=./models